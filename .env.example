# ─────────────────────────────────────────────────────────────
# Buyer Signal Map — environment configuration
# Copy to `.env.local` and fill in. All values are optional for a
# local demo run (the app falls back to DEMO_MODE without a key).
# ─────────────────────────────────────────────────────────────

# --- Claude (report generation engine) ---
# Required for live reports. Without it, the app runs in demo mode and
# returns a deterministic sample report so the UI is fully demonstrable.
ANTHROPIC_API_KEY=

# Model used for extraction + synthesis. Defaults to claude-opus-4-8.
# For lower cost at high volume, set to claude-sonnet-5.
ANTHROPIC_MODEL=claude-opus-4-8

# Force demo mode even if a key is present (useful for previews/tests).
# DEMO_MODE=true

# --- Storage ---
# Directory for persisted lead submissions + reports (JSON files).
# For serverless deploys, point this at a writable volume or swap the
# LeadStore implementation for a database (see src/lib/store/index.ts).
DATA_DIR=.data

# --- Email (optional — report delivery) ---
# EMAIL_PROVIDER: "console" (default, logs only) | "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Streamline Connex <signals@streamlineconnex.com>"

# --- CRM routing (optional) ---
# CRM_PROVIDER: "none" (default) | "webhook"
CRM_PROVIDER=none
CRM_WEBHOOK_URL=

# --- Public brand / CTA links (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=https://streamlineconnex.com/
NEXT_PUBLIC_BOOK_URL=https://streamlineconnex.com/
NEXT_PUBLIC_AUDIT_URL=https://streamlineconnex.com/
